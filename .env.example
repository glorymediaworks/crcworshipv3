# LOCAL DEVELOPMENT ONLY - never commit. Rotate the DB password after deployment.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER_HOST/?retryWrites=true&w=majority
MONGODB_DB=crcworship

# App login (server-side check). Change before going live.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=generate-a-long-random-string

# Existing Google Sheets song / image libraries (read-only, unchanged)
SHEETS_SONGS_URL=https://script.google.com/macros/s/AKfycbyUU7xzuRTD7rL-8GqZyXe9g6TDjb10QTvtZQyk6qca02Q1Fl6DakR0SBkwTEzorSLuwA/exec
SHEETS_IMAGES_URL=https://script.google.com/macros/s/AKfycbxb3wysS_kPuPLalOBO2zNBpd8DieoPqIUppy0iJfw6iyrJDQ7x4SEvytyuKYLK1AZL0A/exec

# Only needed if the front end is hosted on a different origin (e.g. GitHub Pages)
ALLOWED_ORIGIN=*
